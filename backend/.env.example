# ---- Table-Order backend environment (example) ----
# Copy to .env and fill real values. NEVER commit .env. [SEC-01]

# Database
DATABASE_URL=postgresql+psycopg://tableorder:changeme@db:5432/tableorder
POSTGRES_USER=tableorder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tableorder

# Auth / security
JWT_SECRET=please-generate-a-long-random-secret
JWT_EXPIRE_HOURS=16
BCRYPT_ROUNDS=12

# CORS (explicit origins only, no wildcard) [SEC-08]
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# DB pool / timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT_SECONDS=5

# Rate limiting (login attempts) [SEC-11]
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Backup [RES-12]
BACKUP_SCHEDULE_CRON=0 * * * *
BACKUP_RETENTION_DAYS=7

# App
APP_ENV=development
LOG_LEVEL=INFO
